<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fr.mapper.TypeMapper">

    <resultMap id="TypeResult" type="com.fr.entity.Type">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
    </resultMap>

    <select id="getAll" resultMap="TypeResult">
        SELECT id, name FROM type ORDER BY id DESC
    </select>

    <select id="getAllAsc" resultMap="TypeResult">
        SELECT id, name FROM type ORDER BY id ASC
    </select>

    <insert id="insert" parameterType="com.fr.entity.Type">
        INSERT INTO type(name) VALUES(#{name})
    </insert>

    <update id="update" parameterType="com.fr.entity.Type">
        UPDATE type SET name = #{name} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM type WHERE id = #{id}
    </delete>

</mapper>