<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fr.mapper.OrderItemMapper">

    <resultMap id="OrderItemResult" type="com.fr.entity.OrderItem">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="goods_id" property="goodId"/>
        <result column="price" property="price"/>
        <result column="amount" property="amount"/>
    </resultMap>

    <insert id="addOrderItem" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO orderitem (price, amount, goods_id, order_id)
        VALUES (#{price}, #{amount}, #{goodId}, #{orderId})
    </insert>

    <select id="getByOrderId" resultMap="OrderItemResult">
        SELECT id, order_id, goods_id, price, amount
        FROM orderitem
        WHERE order_id = #{orderId}
    </select>

    <delete id="deleteByOrderId">
        DELETE FROM orderitem WHERE order_id = #{orderId}
    </delete>

</mapper>
